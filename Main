
-- // Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

-- // Library
local LibraryURL = "https://raw.githubusercontent.com/MigsV30/roblox-script/refs/heads/AnimeDice/UI"

local Source = HttpService:GetAsync(LibraryURL)
local Library = loadstring(Source)()

-- // UI Title
local ScreenGui = PlayerGui:WaitForChild("HUB")
local MainFrame = ScreenGui:WaitForChild("MainFrame")
local TopFrame = MainFrame:WaitForChild("Top")

TopFrame:WaitForChild("Title").Text = "Anime Dice"
TopFrame:WaitForChild("Subtitle").Text = "Autumn Event"

-- // Configs
local Config = {
	AutumnEvent = {
		CollectApple = {
			Active = false;

			UpdateInterval = 0.3;
			EdgeMargin = 5;
			SearchRadius = 150;
			Directions = 16;

			BindName = "AppleHunterMovement";

			Paths = {
				SafeArea = {"Zones"; "AppleArea"};
				ApplesFolder = {"AutumnApples"};
			};
		};
	};
}

-- // Helpers
local Helpers = {}

function Helpers.GetPath(root, path)
	for _, name in ipairs(path) do
		root = root:WaitForChild(name)
	end

	return root
end

function Helpers.GetCharacterParts()
	local character = Player.Character

	if not character then
		return nil, nil
	end

	return character:FindFirstChildOfClass("Humanoid"),
		character:FindFirstChild("HumanoidRootPart")
end

function Helpers.GetPosition(object)
	if object:IsA("Model") then
		return object:GetPivot().Position
	elseif object:IsA("BasePart") then
		return object.Position
	end

	return nil
end

function Helpers.GetDirection(origin, target)
	local offset = target - origin
	local flat = Vector3.new(offset.X, 0, offset.Z)

	return flat.Magnitude > 0.01 and flat.Unit or nil
end

function Helpers.IsInsideArea(position, area, margin)
	local relative = area.CFrame:PointToObjectSpace(position)
	local half = area.Size / 2

	local limitX = math.max(0, half.X - margin)
	local limitZ = math.max(0, half.Z - margin)

	return math.abs(relative.X) <= limitX
		and math.abs(relative.Z) <= limitZ
end

function Helpers.CanMove(humanoid, root)
	return humanoid
		and root
		and humanoid.Health > 0
		and humanoid.WalkSpeed > 0
		and not root.Anchored
		and not humanoid.PlatformStand
		and not humanoid.Sit
end

-- // Variables
local Variables = {
	AutumnEvent = {
		CollectApple = {
			SafeArea = nil;
			ApplesFolder = nil;

			Direction = Vector3.zero;
			LastUpdate = 0;
		};
	};
}

-- // Functions
local Functions = {
	AutumnEvent = {
		CollectApple = {};
	};
}

-- // CollectApple References
local AppleConfig = Config.AutumnEvent.CollectApple
local AppleVariables = Variables.AutumnEvent.CollectApple
local Apple = Functions.AutumnEvent.CollectApple

-- // Initialization
function Apple.Initialize()
	AppleVariables.SafeArea = Helpers.GetPath(
		workspace,
		AppleConfig.Paths.SafeArea
	)

	AppleVariables.ApplesFolder = Helpers.GetPath(
		workspace,
		AppleConfig.Paths.ApplesFolder
	)
end

-- // Apple Detection
function Apple.GetBestDirection(root)
	local area = AppleVariables.SafeArea
	local folder = AppleVariables.ApplesFolder

	local directions = AppleConfig.Directions
	local radius = AppleConfig.SearchRadius

	local scores = table.create(directions, 0)
	local sums = table.create(directions, Vector3.zero)

	for i = 1, directions do
		scores[i] = 0
		sums[i] = Vector3.zero
	end

	for _, object in ipairs(folder:GetChildren()) do
		if not object.Name:match("^Apple_") then
			continue
		end

		local success, position = pcall(Helpers.GetPosition, object)

		if not success or not position then
			continue
		end

		if not Helpers.IsInsideArea(
			position,
			area,
			AppleConfig.EdgeMargin
		) then
			continue
		end

		local offset = position - root.Position
		local flat = Vector3.new(offset.X, 0, offset.Z)
		local distance = flat.Magnitude

		if distance <= 2 or distance > radius then
			continue
		end

		local angle = math.atan2(flat.Z, flat.X)

		local sector = math.floor(
			((angle + math.pi) / (2 * math.pi)) * directions
		) + 1

		sector = math.clamp(sector, 1, directions)

		local weight = 1 / math.sqrt(distance)

		scores[sector] += weight
		sums[sector] += flat.Unit * weight
	end

	local bestSector
	local bestScore = 0

	for i = 1, directions do
		if scores[i] > bestScore then
			bestScore = scores[i]
			bestSector = i
		end
	end

	if not bestSector then
		return nil
	end

	local direction = sums[bestSector]

	return direction.Magnitude > 0.01
		and direction.Unit
		or nil
end

-- // Movement
function Apple.GetRandomDirection(root)
	local area = AppleVariables.SafeArea
	local margin = AppleConfig.EdgeMargin

	local target = area.CFrame:PointToWorldSpace(Vector3.new(
		(math.random() - 0.5) * math.max(0, area.Size.X - margin * 2),
		0,
		(math.random() - 0.5) * math.max(0, area.Size.Z - margin * 2)
	))

	return Helpers.GetDirection(root.Position, target)
		or Vector3.new(1, 0, 0)
end

function Apple.UpdateDirection(root)
	AppleVariables.Direction =
		Apple.GetBestDirection(root)
		or Apple.GetRandomDirection(root)
end

function Apple.CorrectDirection(root)
	local area = AppleVariables.SafeArea
	local margin = AppleConfig.EdgeMargin

	if Helpers.IsInsideArea(root.Position, area, margin) then
		return
	end

	local localPosition = area.CFrame:PointToObjectSpace(root.Position)
	local half = area.Size / 2

	local target = area.CFrame:PointToWorldSpace(Vector3.new(
		math.clamp(
			localPosition.X,
			-math.max(0, half.X - margin),
			math.max(0, half.X - margin)
		),
		0,
		math.clamp(
			localPosition.Z,
			-math.max(0, half.Z - margin),
			math.max(0, half.Z - margin)
		)
	))

	AppleVariables.Direction =
		Helpers.GetDirection(root.Position, target)
		or AppleVariables.Direction
end

function Apple.Update()
	local humanoid, root = Helpers.GetCharacterParts()

	if not Helpers.CanMove(humanoid, root) then
		return
	end

	local now = os.clock()

	if now - AppleVariables.LastUpdate >= AppleConfig.UpdateInterval then
		AppleVariables.LastUpdate = now
		Apple.UpdateDirection(root)
	end

	Apple.CorrectDirection(root)

	humanoid:Move(AppleVariables.Direction, false)
end

-- // Controls
function Apple.Stop()
	AppleConfig.Active = false

	RunService:UnbindFromRenderStep(AppleConfig.BindName)

	AppleVariables.Direction = Vector3.zero

	local humanoid = Helpers.GetCharacterParts()

	if humanoid then
		humanoid:Move(Vector3.zero, false)
	end
end

function Apple.Start()
	RunService:UnbindFromRenderStep(AppleConfig.BindName)

	AppleConfig.Active = true
	AppleVariables.LastUpdate = 0

	RunService:BindToRenderStep(
		AppleConfig.BindName,
		Enum.RenderPriority.Input.Value + 1,
		function()
			if AppleConfig.Active then
				Apple.Update()
			end
		end
	)
end

function Apple.Toggle()
	if AppleConfig.Active then
		Apple.Stop()
	else
		Apple.Start()
	end
end

-- // Initialization
Apple.Initialize()

-- // UI
Library:CreateCategory(
	"AutumnEvent",
	"Autumn Event"
)

Library:CreateItem(
	"AutumnEvent",
	"CollectApple",
	"Auto Collect Apple",
	function(enabled)
		if enabled then
			Apple.Start()
		else
			Apple.Stop()
		end
	end,
	false
)

-- // Connections
Player.CharacterAdded:Connect(function()
	if not AppleConfig.Active then
		return
	end

	task.wait(1)

	if AppleConfig.Active then
		AppleVariables.LastUpdate = 0
		Apple.Start()
	end
end)
