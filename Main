
-- // Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

-- // Library
local LibraryURL = "https://raw.githubusercontent.com/MigsV30/roblox-script/refs/heads/AnimeDice/UI"

local function LoadLibrary()
    local Source = game:HttpGet(LibraryURL)

    assert(
        type(Source) == "string" and #Source > 0,
        "UI source is empty"
    )

    local Compiler = loadstring

    assert(
        type(Compiler) == "function",
        "loadstring is unavailable"
    )

    local Function, CompileError = Compiler(Source)

    assert(
        type(Function) == "function",
        tostring(CompileError or "UI compilation failed")
    )

    local Success, Result = pcall(Function)

    assert(
        Success,
        tostring(Result)
    )

    assert(
        type(Result) == "table",
        "UI library did not return a valid table"
    )

    return Result
end

local Success, Library = pcall(LoadLibrary)

if not Success then
    warn("[Anime Dice] UI Error:", Library)
    return
end

-- // UI Configuration
local ScreenGui = PlayerGui:WaitForChild("HUB", 10)

if not ScreenGui then
    warn("[Anime Dice] HUB was not created")
    return
end

local MainFrame = ScreenGui:WaitForChild("MainFrame", 5)
local TopFrame = MainFrame and MainFrame:WaitForChild("Top", 5)

if not TopFrame then
    warn("[Anime Dice] UI header was not found")
    return
end

local Title = TopFrame:FindFirstChild("Title")
local Subtitle = TopFrame:FindFirstChild("Subtitle")

if Title then
    Title.Text = "Anime Dice"
end

if Subtitle then
    Subtitle.Text = "Autumn Event"
end

-- // Configs
local Config = {
    AutumnEvent = {
        CollectApple = {
            Active = false;

            UpdateInterval = 0.3;
            EdgeMargin = 5;
            SearchRadius = 150;
            Directions = 16;

            BindName = "AppleHunterMovement";

            Paths = {
                SafeArea = {"Zones"; "AppleArea"};
                ApplesFolder = {"AutumnApples"};
            };
        };
    };
}

-- // Helpers
local Helpers = {}

function Helpers.GetPath(Root, Path)
    for _, Name in ipairs(Path) do
        Root = Root:WaitForChild(Name)
    end

    return Root
end

function Helpers.GetCharacterParts()
    local Character = Player.Character

    if not Character then
        return nil, nil
    end

    return Character:FindFirstChildOfClass("Humanoid"),
        Character:FindFirstChild("HumanoidRootPart")
end

function Helpers.GetPosition(Object)
    if Object:IsA("Model") then
        return Object:GetPivot().Position
    elseif Object:IsA("BasePart") then
        return Object.Position
    end

    return nil
end

function Helpers.GetDirection(Origin, Target)
    local Offset = Target - Origin
    local Flat = Vector3.new(Offset.X, 0, Offset.Z)

    return Flat.Magnitude > 0.01
        and Flat.Unit
        or nil
end

function Helpers.IsInsideArea(Position, Area, Margin)
    local Relative = Area.CFrame:PointToObjectSpace(Position)
    local Half = Area.Size / 2

    local LimitX = math.max(0, Half.X - Margin)
    local LimitZ = math.max(0, Half.Z - Margin)

    return math.abs(Relative.X) <= LimitX
        and math.abs(Relative.Z) <= LimitZ
end

function Helpers.CanMove(Humanoid, Root)
    return Humanoid
        and Root
        and Humanoid.Health > 0
        and Humanoid.WalkSpeed > 0
        and not Root.Anchored
        and not Humanoid.PlatformStand
        and not Humanoid.Sit
end

-- // Variables
local Variables = {
    AutumnEvent = {
        CollectApple = {
            SafeArea = nil;
            ApplesFolder = nil;

            Direction = Vector3.zero;
            LastUpdate = 0;
        };
    };
}

-- // Functions
local Functions = {
    AutumnEvent = {
        CollectApple = {};
    };
}

-- // CollectApple References
local AppleConfig = Config.AutumnEvent.CollectApple
local AppleVariables = Variables.AutumnEvent.CollectApple
local Apple = Functions.AutumnEvent.CollectApple

-- // Initialization
function Apple.Initialize()
    AppleVariables.SafeArea = Helpers.GetPath(
        workspace,
        AppleConfig.Paths.SafeArea
    )

    AppleVariables.ApplesFolder = Helpers.GetPath(
        workspace,
        AppleConfig.Paths.ApplesFolder
    )
end

-- // Apple Detection
function Apple.GetBestDirection(Root)
    local Area = AppleVariables.SafeArea
    local Folder = AppleVariables.ApplesFolder

    local Directions = AppleConfig.Directions
    local Radius = AppleConfig.SearchRadius

    local Scores = table.create(Directions, 0)
    local Sums = table.create(Directions, Vector3.zero)

    for Index = 1, Directions do
        Scores[Index] = 0
        Sums[Index] = Vector3.zero
    end

    for _, Object in ipairs(Folder:GetChildren()) do
        if not Object.Name:match("^Apple_") then
            continue
        end

        local Success, Position = pcall(
            Helpers.GetPosition,
            Object
        )

        if not Success or not Position then
            continue
        end

        if not Helpers.IsInsideArea(
            Position,
            Area,
            AppleConfig.EdgeMargin
        ) then
            continue
        end

        local Offset = Position - Root.Position
        local Flat = Vector3.new(Offset.X, 0, Offset.Z)
        local Distance = Flat.Magnitude

        if Distance <= 2 or Distance > Radius then
            continue
        end

        local Angle = math.atan2(Flat.Z, Flat.X)

        local Sector = math.floor(
            ((Angle + math.pi) / (2 * math.pi)) * Directions
        ) + 1

        Sector = math.clamp(Sector, 1, Directions)

        local Weight = 1 / math.sqrt(Distance)

        Scores[Sector] += Weight
        Sums[Sector] += Flat.Unit * Weight
    end

    local BestSector
    local BestScore = 0

    for Index = 1, Directions do
        if Scores[Index] > BestScore then
            BestScore = Scores[Index]
            BestSector = Index
        end
    end

    if not BestSector then
        return nil
    end

    local Direction = Sums[BestSector]

    return Direction.Magnitude > 0.01
        and Direction.Unit
        or nil
end

-- // Movement
function Apple.GetRandomDirection(Root)
    local Area = AppleVariables.SafeArea
    local Margin = AppleConfig.EdgeMargin

    local Target = Area.CFrame:PointToWorldSpace(Vector3.new(
        (math.random() - 0.5) * math.max(0, Area.Size.X - Margin * 2),
        0,
        (math.random() - 0.5) * math.max(0, Area.Size.Z - Margin * 2)
    ))

    return Helpers.GetDirection(
        Root.Position,
        Target
    ) or Vector3.new(1, 0, 0)
end

function Apple.UpdateDirection(Root)
    AppleVariables.Direction =
        Apple.GetBestDirection(Root)
        or Apple.GetRandomDirection(Root)
end

function Apple.CorrectDirection(Root)
    local Area = AppleVariables.SafeArea
    local Margin = AppleConfig.EdgeMargin

    if Helpers.IsInsideArea(
        Root.Position,
        Area,
        Margin
    ) then
        return
    end

    local LocalPosition = Area.CFrame:PointToObjectSpace(
        Root.Position
    )

    local Half = Area.Size / 2

    local LimitX = math.max(0, Half.X - Margin)
    local LimitZ = math.max(0, Half.Z - Margin)

    local Target = Area.CFrame:PointToWorldSpace(Vector3.new(
        math.clamp(LocalPosition.X, -LimitX, LimitX),
        0,
        math.clamp(LocalPosition.Z, -LimitZ, LimitZ)
    ))

    AppleVariables.Direction =
        Helpers.GetDirection(
            Root.Position,
            Target
        ) or AppleVariables.Direction
end

function Apple.Update()
    local Humanoid, Root = Helpers.GetCharacterParts()

    if not Helpers.CanMove(Humanoid, Root) then
        return
    end

    local Now = os.clock()

    if Now - AppleVariables.LastUpdate >= AppleConfig.UpdateInterval then
        AppleVariables.LastUpdate = Now
        Apple.UpdateDirection(Root)
    end

    Apple.CorrectDirection(Root)

    Humanoid:Move(
        AppleVariables.Direction,
        false
    )
end

-- // Controls
function Apple.Stop()
    AppleConfig.Active = false

    RunService:UnbindFromRenderStep(
        AppleConfig.BindName
    )

    AppleVariables.Direction = Vector3.zero

    local Humanoid = Helpers.GetCharacterParts()

    if Humanoid then
        Humanoid:Move(Vector3.zero, false)
    end
end

function Apple.Start()
    RunService:UnbindFromRenderStep(
        AppleConfig.BindName
    )

    AppleConfig.Active = true
    AppleVariables.LastUpdate = 0

    RunService:BindToRenderStep(
        AppleConfig.BindName,
        Enum.RenderPriority.Input.Value + 1,
        function()
            if AppleConfig.Active then
                Apple.Update()
            end
        end
    )
end

function Apple.Toggle()
    if AppleConfig.Active then
        Apple.Stop()
    else
        Apple.Start()
    end
end

-- // Initialization
local InitSuccess, InitError = pcall(Apple.Initialize)

if not InitSuccess then
    warn("[Anime Dice] Initialization Error:", InitError)
    Library:Destroy()
    return
end

-- // UI
local UISuccess, UIError = pcall(function()
    Library:CreateCategory(
        "AutumnEvent",
        "Autumn Event"
    )

    Library:CreateItem(
        "AutumnEvent",
        "CollectApple",
        "Auto Collect Apple",
        function(Enabled)
            if Enabled then
                Apple.Start()
            else
                Apple.Stop()
            end
        end,
        false
    )
end)

if not UISuccess then
    warn("[Anime Dice] UI Creation Error:", UIError)
    Library:Destroy()
    return
end

-- // Connections
Player.CharacterAdded:Connect(function()
    if not AppleConfig.Active then
        return
    end

    task.wait(1)

    if AppleConfig.Active then
        AppleVariables.LastUpdate = 0
        Apple.Start()
    end
end)
