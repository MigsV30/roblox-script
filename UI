	Button.AnchorPoint = Vector2.new(1, 0.5)
	Button.Position = UDim2.new(0.96, 0, 0.5, 0)
	Button.Size = UDim2.new(0.22, 0, 0.58, 0)
	Button.BackgroundTransparency = 1
	Button.BorderSizePixel = 0
	Button.AutoButtonColor = true
	Button.Image = "rbxassetid://115244835457218"
	Button.ImageColor3 = Color3.fromRGB(255, 255, 255)
	Button.ScaleType = Enum.ScaleType.Slice
	Button.SliceCenter = Rect.new(50, 50, 50, 50)

	local ToggleText = Instance.new("TextLabel")
	ToggleText.Name = "StateLabel"
	ToggleText.Parent = Button
	ToggleText.AnchorPoint = Vector2.new(0.5, 0.5)
	ToggleText.BackgroundTransparency = 1
	ToggleText.Position = UDim2.new(0.5, 0, 0.5, 0)
	ToggleText.Size = UDim2.new(0.5, 0, 0.6, 0)
	ToggleText.ZIndex = 2
	ToggleText.Font = Enum.Font.BuilderSansBold
	ToggleText.Text = DefaultState and "ON" or "OFF"
	ToggleText.TextColor3 = Color3.fromRGB(255, 255, 255)
	ToggleText.TextScaled = true
	ToggleText.TextWrapped = true
	ToggleText.TextXAlignment = Enum.TextXAlignment.Center
	ToggleText.TextYAlignment = Enum.TextYAlignment.Center
	AddTextStroke(ToggleText, 0.08)

	local State = DefaultState
	local function SetState(NewState)
		State = NewState == true
		ToggleText.Text = State and "ON" or "OFF"

		if Callback then
			task.spawn(function()
				local Success, ErrorMessage = pcall(Callback, State)
				if not Success then
					warn("[HUB] Item callback error:", ErrorMessage)
				end
			end)
		end
	end

	Button.Activated:Connect(function()
		SetState(not State)
	end)

	return {
		Frame = Frame,
		Button = Button,
		Title = Title,
		GetState = function()
			return State
		end,
		SetState = SetState,
	}
end

-- // Public API: Create Item
function UI:CreateItem(CategoryName: string, Name: string, Text: string, Callback, DefaultState: boolean?)
	assert(Categories[CategoryName], "Category does not exist: " .. tostring(CategoryName))
	assert(type(Name) == "string" and Name ~= "", "Item name must be a non-empty string")
	assert(type(Text) == "string", "Item text must be a string")
	assert(Callback == nil or type(Callback) == "function", "Callback must be a function or nil")

	local CategoryData = Categories[CategoryName]
	assert(not CategoryData.ItemNames or not CategoryData.ItemNames[Name], "An item with this name already exists in this category")

	CategoryData.ItemNames = CategoryData.ItemNames or {}
	CategoryData.ItemNames[Name] = true

	ItemOrder += 1
	local ItemData = CreateMainContainerItem(Name, Text, ItemOrder, DefaultState == true, Callback)
	ItemData.Frame.Parent = MainContainer
	table.insert(CategoryData.Items, ItemData)

	-- Items are only visible while their category is selected.
	ItemData.Frame.Visible = SelectedCategory == CategoryData

	return ItemData
end

-- // Public API: GUI Name / Title / Subtitle Configuration
function UI:SetGuiName(Name: string)
	assert(type(Name) == "string" and Name ~= "", "ScreenGui name must be a non-empty string")

	local Existing = PlayerGui:FindFirstChild(Name)
	assert(not Existing or Existing == ScreenGui, "A ScreenGui with this name already exists: " .. Name)

	ScreenGui.Name = Name
	GUI_CONFIG.Name = Name
	return ScreenGui
end

function UI:SetTitle(Text: string)
	assert(type(Text) == "string", "Title must be a string")
	Title.Text = Text
	GUI_CONFIG.Title = Text
end

function UI:SetSubtitle(Text: string)
	assert(type(Text) == "string", "Subtitle must be a string")
	Subtitle.Text = Text
	GUI_CONFIG.Subtitle = Text
end

function UI:Configure(Options)
	assert(type(Options) == "table", "Configure expects a table")

	if Options.Name ~= nil then
		self:SetGuiName(Options.Name)
	end
	if Options.Title ~= nil then
		self:SetTitle(Options.Title)
	end
	if Options.Subtitle ~= nil then
		self:SetSubtitle(Options.Subtitle)
	end

	return self
end

-- // Public API: Toggle / Visibility / Cleanup
function UI:SetEnabled(Enabled: boolean)
	local IsEnabled = Enabled == true
	MainFrame.Visible = IsEnabled
	ReopenButton.Visible = not IsEnabled
end

function UI:Hide()
	self:SetEnabled(false)
end

function UI:Show()
	self:SetEnabled(true)
end

function UI:Destroy()
	ScreenGui:Destroy()
	table.clear(Categories)
	SelectedCategory = nil
end

-- Clicking the floating image restores the hub.
ReopenButton.Activated:Connect(function()
	UI:Show()
end)

-- // Keyboard Shortcut
local InputConnection

InputConnection = UserInputService.InputBegan:Connect(function(Input, GameProcessedEvent)
	if GameProcessedEvent then
		return
	end

	if Input.KeyCode == Enum.KeyCode.LeftControl
		or Input.KeyCode == Enum.KeyCode.RightControl then
		UI:SetEnabled(not MainFrame.Visible)
	end
end)

ScreenGui.Destroying:Connect(function()
	if InputConnection then
		InputConnection:Disconnect()
	end
end)

-- // Return Library
return UI
