-- // Library Data
local UI = {}
local Categories = {}
local SelectedCategory = nil
local CategoryOrder = 0
local ItemOrder = 0

-- // Select Category
local function SelectCategory(CategoryData)
	SelectedCategory = CategoryData

	for _, Data in pairs(Categories) do
		Data.Button.BackgroundTransparency = (Data == CategoryData) and 0.8 or 1
	end

	for _, ItemData in ipairs(CategoryData.Items) do
		ItemData.Frame.Visible = true
	end

	for _, Data in pairs(Categories) do
		if Data ~= CategoryData then
			for _, ItemData in ipairs(Data.Items) do
				ItemData.Frame.Visible = false
			end
		end
	end
end

-- // Create Category
function UI:CreateCategory(Name: string, Text: string?)
	assert(type(Name) == "string" and Name ~= "", "Category name must be a non-empty string")
	assert(not Categories[Name], "A category with this name already exists")

	CategoryOrder += 1
	local Button, Label = CreateCategoryButton(Name, Text or Name, CategoryOrder)
	Button.BackgroundTransparency = 1

	local CategoryData = {
		Name = Name,
		Button = Button,
		Label = Label,
		Items = {},
	}

	Categories[Name] = CategoryData
	Button.Activated:Connect(function()
		SelectCategory(CategoryData)
	end)

	if not SelectedCategory then
		SelectCategory(CategoryData)
	end

	return CategoryData
end

