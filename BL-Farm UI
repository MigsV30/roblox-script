-- // Button Factory

local function CreateButton(Parent, Name, Text, Position, ColorName, Size)
	local Button = Instance.new("TextButton")
	Button.Name = Name
	Button.Parent = Parent
	Button.AnchorPoint = Vector2.new(1, 0.5)
	Button.BackgroundColor3 = Color3.new(1, 1, 1)
	Button.Position = Position
	Button.Size = Size or UDim2.new(0.19, 0, 0.649, 0)
	Button.Text = ""
	Button.AutoButtonColor = false
	Button.ZIndex = 1

	AddCorner(Button)

	local Gradient = Instance.new("UIGradient")
	Gradient.Name = "Gradient"
	Gradient.Parent = Button
	Gradient.Color = gradients[ColorName] or gradients.White
	Gradient.Rotation = gradientsRotation

	local Shadow = Instance.new("Frame")
	Shadow.Name = "ColorShadow"
	Shadow.Parent = Button
	Shadow.AnchorPoint = Vector2.new(0.5, 0.5)
	Shadow.BackgroundColor3 = Color3.fromRGB(178, 178, 178)
	Shadow.Position = UDim2.new(0.5, 0, 0.5, 0)
	Shadow.Size = UDim2.new(0.965, 0, 0.85, 0)
	Shadow.ZIndex = 2

	AddCorner(Shadow)

	local ShadowGradient = Instance.new("UIGradient")
	ShadowGradient.Name = "Gradient"
	ShadowGradient.Parent = Shadow
	ShadowGradient.Color = gradients[ColorName] or gradients.White
	ShadowGradient.Rotation = gradientsRotation
	ShadowGradient.Transparency = gradientTransparency

	local TextLabel = Instance.new("TextLabel")
	TextLabel.Name = "Label"
	TextLabel.Parent = Shadow
	TextLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	TextLabel.BackgroundTransparency = 1
	TextLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
	TextLabel.Size = UDim2.new(1, 0, 0.57, 0)
	TextLabel.ZIndex = 3
	TextLabel.Font = Enum.Font.FredokaOne
	TextLabel.Text = Text
	TextLabel.TextColor3 = Color3.new(1, 1, 1)
	TextLabel.TextScaled = true
	TextLabel.TextWrapped = true

	AddTextStroke(TextLabel)

	return Button, TextLabel
end

-- // Create Container Item

local function CreateContainerItem(
	ItemName,
	ItemDesc,
	HasSelection,
	SelectText,
	OnToggleChanged,
	OnSelectClicked
)
	HasSelection = HasSelection or false
	SelectText = SelectText or "Select"

	local ContainerItem = Instance.new("Frame")
	ContainerItem.Name = ItemName
	ContainerItem.Parent = MainContainer
	ContainerItem.BackgroundColor3 = Color3.new(0, 0, 0)
	ContainerItem.BackgroundTransparency = 0.5
	ContainerItem.Size = UDim2.new(0.956, 0, 0.174, 0)

	AddCorner(ContainerItem, UDim.new(0.1, 0))

	local InnerStroke = AddStroke(
		ContainerItem,
		Color3.new(1, 1, 1),
		0.04,
		0.88
	)
	InnerStroke.StrokeSizingMode = Enum.StrokeSizingMode.ScaledSize

	local OuterStroke = AddStroke(
		ContainerItem,
		Color3.new(0, 0, 0),
		0.04
	)
	OuterStroke.StrokeSizingMode = Enum.StrokeSizingMode.ScaledSize

	-- // Name

	local NameLabel = Instance.new("TextLabel")
	NameLabel.Name = "Name"
	NameLabel.Parent = ContainerItem
	NameLabel.AnchorPoint = Vector2.new(0, 0.5)
	NameLabel.BackgroundTransparency = 1
	NameLabel.Position = UDim2.new(0.015, 0, 0.321, 0)
	NameLabel.Size = UDim2.new(0.394, 0, 0.401, 0)
	NameLabel.ZIndex = 2
	NameLabel.Font = Enum.Font.FredokaOne
	NameLabel.Text = ItemName
	NameLabel.TextColor3 = Color3.new(1, 1, 1)
	NameLabel.TextScaled = true
	NameLabel.TextWrapped = true
	NameLabel.TextXAlignment = Enum.TextXAlignment.Left

	AddTextStroke(NameLabel)

	-- // Description

	local Desc = Instance.new("TextLabel")
	Desc.Name = "Desc"
	Desc.Parent = ContainerItem
	Desc.AnchorPoint = Vector2.new(0, 0.5)
	Desc.BackgroundTransparency = 1
	Desc.Position = UDim2.new(0.015, 0, 0.7, 0)
	Desc.Size = UDim2.new(0.54, 0, 0.3, 0)
	Desc.ZIndex = 2
	Desc.Font = Enum.Font.FredokaOne
	Desc.Text = ItemDesc
	Desc.TextColor3 = Color3.new(1, 1, 1)
	Desc.TextScaled = true
	Desc.TextTransparency = 0.5
	Desc.TextWrapped = true
	Desc.TextXAlignment = Enum.TextXAlignment.Left

	AddTextStroke(Desc)

	-- // Toggle Button

	local ToggleButton, ToggleLabel = CreateButton(
		ContainerItem,
		"Toggle",
		"OFF",
		HasSelection
			and UDim2.new(0.765, 0, 0.5, 0)
			or UDim2.new(0.985, 0, 0.5, 0),
		"Red"
	)

	-- // Selection Button

	local SelectButton

	if HasSelection then
		SelectButton = CreateButton(
			ContainerItem,
			"Select",
			SelectText,
			UDim2.new(0.985, 0, 0.5, 0),
			"Blue"
		)
	end

	-- // Toggle Logic

	local Enabled = false

	local function SetEnabled(Value, FireCallback)
		Enabled = Value == true

		local ColorName = Enabled and "Green" or "Red"
		ToggleLabel.Text = Enabled and "ON" or "OFF"

		ToggleButton.Gradient.Color = gradients[ColorName]
		ToggleButton.ColorShadow.Gradient.Color = gradients[ColorName]

		if FireCallback and OnToggleChanged then
			OnToggleChanged(Enabled)
		end
	end

	ToggleButton.Activated:Connect(function()
		SetEnabled(not Enabled, true)
	end)

	-- // Select Logic

	if SelectButton then
		SelectButton.Activated:Connect(function()
			if OnSelectClicked then
				OnSelectClicked()
			end
		end)
	end

	-- // Return References

	return {
		Container = ContainerItem,
		ToggleButton = ToggleButton,
		ToggleLabel = ToggleLabel,
		SelectButton = SelectButton,

		IsEnabled = function()
			return Enabled
		end,

		SetEnabled = function(Value)
			SetEnabled(Value, false)
		end,

		SetSelectText = function(Text)
			if SelectButton then
				SelectButton.ColorShadow.Label.Text = Text
			end
		end,

		SetDescription = function(Text)
			Desc.Text = Text
		end,

		SetName = function(Text)
			NameLabel.Text = Text
			ContainerItem.Name = Text
		end,

		Destroy = function()
			ContainerItem:Destroy()
		end
	}
end

-- // Create Select Button

local function CreateSelectButton(Name, ColorName, OnSelectionChanged)
	ColorName = gradients[ColorName] and ColorName or "Blue"

	local Button = Instance.new("TextButton")
	Button.Name = Name
	Button.Size = UDim2.new(0.25, 0, 0.9, 0)
	Button.Text = ""
	Button.AutoButtonColor = false
	Button.BackgroundColor3 = Color3.new(1, 1, 1)
	Button.Parent = SelectScroll

	AddCorner(Button)

	local ButtonGradient = Instance.new("UIGradient")
	ButtonGradient.Name = "Gradient"
	ButtonGradient.Parent = Button
	ButtonGradient.Color = gradients.White
	ButtonGradient.Rotation = gradientsRotation

	local Shadow = Instance.new("Frame")
	Shadow.Name = "ColorShadow"
	Shadow.Parent = Button
	Shadow.AnchorPoint = Vector2.new(0.5, 0.5)
	Shadow.BackgroundColor3 = Color3.fromRGB(178, 178, 178)
	Shadow.Position = UDim2.new(0.5, 0, 0.5, 0)
	Shadow.Size = UDim2.new(0.976, 0, 0.85, 0)
	Shadow.ZIndex = 2

	AddCorner(Shadow)

	local ShadowGradient = Instance.new("UIGradient")
	ShadowGradient.Name = "Gradient"
	ShadowGradient.Parent = Shadow
	ShadowGradient.Color = gradients.White
	ShadowGradient.Rotation = gradientsRotation
	ShadowGradient.Transparency = gradientTransparency

	-- // Label

	local TextLabel = Instance.new("TextLabel")
	TextLabel.Name = "Label"
	TextLabel.Parent = Shadow
	TextLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	TextLabel.BackgroundTransparency = 1
	TextLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
	TextLabel.Size = UDim2.new(1, 0, 0.57, 0)
	TextLabel.ZIndex = 3
	TextLabel.Font = Enum.Font.FredokaOne
	TextLabel.Text = Name
	TextLabel.TextColor3 = Color3.new(1, 1, 1)
	TextLabel.TextScaled = true
	TextLabel.TextWrapped = true

	AddTextStroke(TextLabel)

	-- // Selected Icon

	local Selected = Instance.new("ImageLabel")
	Selected.Name = "Selected"
	Selected.Parent = Shadow
	Selected.BackgroundTransparency = 1
	Selected.AnchorPoint = Vector2.new(0.5, 0.5)
	Selected.Position = UDim2.new(0.9, 0, 0.5, 0)
	Selected.Size = UDim2.new(0.155, 0, 0.685, 0)
	Selected.Image = "rbxassetid://15540208282"
	Selected.ScaleType = Enum.ScaleType.Fit
	Selected.Visible = false
	Selected.ZIndex = 4

	-- // Selection Logic

	local IsSelected = false

	local function SetSelected(Value, FireCallback)
		IsSelected = Value == true

		local SelectedColor = IsSelected and ColorName or "White"

		ButtonGradient.Color = gradients[SelectedColor]
		ShadowGradient.Color = gradients[SelectedColor]
		Selected.Visible = IsSelected

		if FireCallback and OnSelectionChanged then
			OnSelectionChanged(IsSelected)
		end
	end

	Button.Activated:Connect(function()
		SetSelected(not IsSelected, true)
	end)

	return {
		Button = Button,
		Selected = Selected,

		IsSelected = function()
			return IsSelected
		end,

		SetSelected = function(Value)
			SetSelected(Value, false)
		end,

		SetName = function(Text)
			TextLabel.Text = Text
			Button.Name = Text
		end,

		Destroy = function()
			Button:Destroy()
		end
	}
end

-- // Public API

local UI = {}

function UI:CreateContainerItem(
	ItemName,
	ItemDesc,
	HasSelection,
	SelectText,
	OnToggleChanged,
	OnSelectClicked
)
	return CreateContainerItem(
		ItemName,
		ItemDesc,
		HasSelection,
		SelectText,
		OnToggleChanged,
		OnSelectClicked
	)
end

function UI:CreateSelectButton(Name, ColorName, OnSelectionChanged)
	return CreateSelectButton(Name, ColorName, OnSelectionChanged)
end

function UI:SetTitle(Text)
	Title.Text = Text
end

function UI:SetSubtitle(Text)
	Subtitle.Text = Text
end

function UI:SetVisible(Value)
	ScreenGui.Enabled = Value == true
end

function UI:ToggleVisible()
	ScreenGui.Enabled = not ScreenGui.Enabled
end

function UI:ShowSelectionBar(Value)
	SelectScroll.Visible = Value == true
end

function UI:Destroy()
	ScreenGui:Destroy()
end

-- // Public References

UI.ScreenGui = ScreenGui
UI.MainFrame = MainFrame
UI.MainContainer = MainContainer
UI.SelectScroll = SelectScroll

-- // Keyboard Shortcut

local InputConnection

InputConnection = UserInputService.InputBegan:Connect(function(
	Input,
	GameProcessedEvent
)
	if GameProcessedEvent then
		return
	end

	if Input.KeyCode == Enum.KeyCode.LeftControl
		or Input.KeyCode == Enum.KeyCode.RightControl then
		ScreenGui.Enabled = not ScreenGui.Enabled
	end
end)

ScreenGui.Destroying:Connect(function()
	if InputConnection then
		InputConnection:Disconnect()
	end
end)

-- // Return Library

return UI
