	local DifficultyName = DifficultyConfig.Name

	DifficultyButtons[DifficultyName] = UI:CreateSelectButton(DifficultyName, DifficultyConfig.Color,
		function(IsSelected)
			-- Atualiza a dificuldade selecionada.
			AutoFarms.Obby.Difficulty[DifficultyName] = IsSelected

			-- Limpa o cooldown ao desmarcar a dificuldade.
			if not IsSelected then
				AutoFarms.Obby.DifficultyCD[DifficultyName] = nil
			end

			print("[BL: Farm] Obby", DifficultyName, IsSelected and "ativado" or "desativado")
		end)
end

