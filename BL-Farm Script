-- // General Functions \\ --

local function Teleport(Position: CFrame)
	local Character = Player.Character
	if not Character then return false end

	local Humanoid = Character:FindFirstChildOfClass("Humanoid")
	local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")

	if not Humanoid or not HumanoidRootPart then
		return false
	end

	Character:PivotTo(Position)
	return true
end

local function IsNight()
	local NightAttribute = Lighting:GetAttribute("IsNight")
	if NightAttribute == true then
		return true
	else
		return false
	end
end

local function SetAutoFarm(Name: string, Enabled: boolean)
	if not AutoFarms[Name] then
		return
	end

	if Enabled and Name == "Variants" then
		AutoFarms.Items.Active = false
	elseif Enabled and Name == "Items" then
		AutoFarms.Variants.Active = false
	end

	AutoFarms[Name].Active = Enabled
end

-- // Functions & Variables \\ --

local itemIndex, variantIndex = 1, 1

local halloweenIndex = 1
local halloweenNight = false
local nextNightCheck = 0

local NIGHT_CHECK_INTERVAL = 120 -- 2 minutos
local DAY_CHECK_INTERVAL = 300 -- 5 minutos

local function AutoObby()
	local Obby = AutoFarms.Obby
	if not Obby.Active then
		return false
	end

	local CurrentTime = os.time()

	for Difficulty, Config in pairs(Positions.Obby) do
		if Obby.Difficulty[Difficulty] == true then
			local CooldownEnd = Obby.DifficultyCD[Difficulty]

			if not CooldownEnd or CurrentTime >= CooldownEnd then
				if Teleport(Config[1]) then
					local VictoryPart = ObbyParts[Difficulty .. "Obby"]

					print(
						"[BL: Farm] Teleport realizado | Dificuldade:",
						Difficulty
					)

					for i = 1, 5 do
						print(
							"[BL: Farm] Chamando ClaimObbyBonus | Chamada:",
							i,
							"/5 | Dificuldade:",
							Difficulty
						)

						ClaimObbyBonus:FireServer(VictoryPart)
					end

					Obby.DifficultyCD[Difficulty] = os.time() + Config.CD

					return true
				end
			end
		end
	end

	return false
end

local function AutoItems()
	if not AutoFarms.Items.Active or #Positions.Items == 0 then
		return false
	end

	local Config = Positions.Items[itemIndex]
	if not Config then
		return false
	end

	local ItemsPart = ItemParts["Part" .. itemIndex]

	if Teleport(Config[1]) then
		print("[BL: Farm] Teleport realizado | Item:", itemIndex)

		for i = 1, 5 do
			print(
				"[BL: Farm] Chamando CollectCollectableObject | Chamada:",
				i,
				"/5 | Item:",
				ItemsPart and ItemsPart.Name or "nil"
			)

			ItemCollect:FireServer(ItemsPart)
		end

		itemIndex = (itemIndex % #Positions.Items) + 1

		return true
	end

	return false
end

local function AutoVariants()
	if not AutoFarms.Variants.Active or #Positions.Variants == 0 then
		return false
	end

	local Config = Positions.Variants[variantIndex]
	if not Config then
		return false
	end

	local VariantPart = VariantParts["Part" .. variantIndex]

	if Teleport(Config[1]) then
		print("[BL: Farm] Teleport realizado | Variante:", variantIndex)

		for i = 1, 5 do
			print(
				"[BL: Farm] Chamando CollectVariantTokenSpawn | Chamada:",
				i,
				"/5 | Variante:",
				VariantPart and VariantPart.Name or "nil"
			)

			VariantCollect:FireServer(VariantPart)
		end

		variantIndex = (variantIndex % #Positions.Variants) + 1

		return true
	end

	return false
end

local function AutoHalloween()
	local Halloween = AutoFarms.Halloween

	if not Halloween.Active then
		return false
	end

	local CurrentTime = os.time()

	if CurrentTime >= nextNightCheck then
		halloweenNight = IsNight()

		if halloweenNight then
			nextNightCheck = CurrentTime + NIGHT_CHECK_INTERVAL
		else
			nextNightCheck = CurrentTime + DAY_CHECK_INTERVAL
			return false
		end
	end

	if not halloweenNight then
		return false
	end

	local Config = Positions.Halloween[halloweenIndex]
	if not Config then
		return false
	end

	if Teleport(Config[1]) then
		task.wait(0.2)

		print("[BL: Farm] Interagindo com porta Halloween | Posição:", halloweenIndex)

		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)

		task.wait(0.1)

		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
		halloweenIndex = (halloweenIndex % #Positions.Halloween) + 1

		return true
	end

	return false
end


