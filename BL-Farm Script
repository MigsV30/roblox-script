-- // Synchronize Features

local function UpdateFeature(Name, Enabled)
	-- Atualiza a configuração da feature.
	SetAutoFarm(Name, Enabled)

	-- Sincroniza o estado visual de features exclusivas.
	if Name == "Variants" and Enabled then
		if FeatureButtons.Items then
			FeatureButtons.Items.SetEnabled(false)
		end
	elseif Name == "Items" and Enabled then
		if FeatureButtons.Variants then
			FeatureButtons.Variants.SetEnabled(false)
		end
	end
end

-- // Auto Variants
FeatureButtons.Variants = UI:CreateContainerItem(
	AutoFarms.Variants.Name,
	AutoFarms.Variants.Desc,
	false,
	nil,
	function(Enabled)
		UpdateFeature("Variants", Enabled)
	end)

-- // Auto Obby
FeatureButtons.Obby = UI:CreateContainerItem(
	AutoFarms.Obby.Name,
	AutoFarms.Obby.Desc,
	true,
	"Select Difficulty",
	function(Enabled)
		UpdateFeature("Obby", Enabled)
	end,
	function()
		UI:ShowSelectionBar(not UI.SelectScroll.Visible)
	end
)


