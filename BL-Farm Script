	if Name == "Variants" and Enabled then
		if FeatureButtons.Items then
			FeatureButtons.Items.SetEnabled(false)
		end
	elseif Name == "Items" and Enabled then
		if FeatureButtons.Variants then
			FeatureButtons.Variants.SetEnabled(false)
		end
	end
end

