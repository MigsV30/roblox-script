-- // Day & Night Schedule \\ --

local CYCLE_START_TIMESTAMP = 1787848200
local DAY_DURATION = 600
local NIGHT_DURATION = 300
local CYCLE_DURATION = DAY_DURATION + NIGHT_DURATION

local LastNightState = nil

local function IsNight()
	local ServerTime = workspace:GetServerTimeNow()

	local CycleTime =
		(ServerTime - CYCLE_START_TIMESTAMP) % CYCLE_DURATION

	return CycleTime >= DAY_DURATION
end

local function CheckDayNight()
	local CurrentNightState = IsNight()

	if CurrentNightState ~= LastNightState then
		LastNightState = CurrentNightState

		if CurrentNightState then
			print("[BL: Farm] 🌙 Ficou de NOITE!")
		else
			print("[BL: Farm] ☀️ Ficou de DIA!")
		end
	end

	return CurrentNightState
end

-- // Character & Teleport \\ --

local function Teleport(Position)
	local Character = Player.Character

	if not Character then
		return false
	end

	local Humanoid = Character:FindFirstChildOfClass("Humanoid")
	local RootPart = Character:FindFirstChild("HumanoidRootPart")

	if not Humanoid or not RootPart or Humanoid.Health <= 0 then
		return false
	end

	Character:PivotTo(Position)

	return true
end

-- // Feature State \\ --

local function SetAutoFarm(Name, Enabled)
	local Config = AutoFarms[Name]

	if not Config then
		return
	end

	if Enabled and Name == "Variants" then
		AutoFarms.Items.Active = false
	elseif Enabled and Name == "Items" then
		AutoFarms.Variants.Active = false
	end

	Config.Active = Enabled

	print("[BL: Farm]", Config.Name, Enabled and "ativado" or "desativado")
end

-- // Indices & Cooldowns \\ --

local ItemIndex = 1
local LastObbyTP = 0
local VariantIndex = 1
local HalloweenIndex = 1


-- // Auto Obby \\ --

local function AutoObby()
	local Obby = AutoFarms.Obby

	if not Obby.Active then
		return false
	end

	-- Cooldown global entre teleportes
	local Now = os.clock()

	if Now - LastObbyTP < Obby.TP_CD then
		return false
	end

	for Difficulty, Config in pairs(Positions.Obby) do
		if Obby.Difficulty[Difficulty] then
			local CooldownEnd = Obby.DifficultyCD[Difficulty]

			-- Cooldown individual da recompensa
			if not CooldownEnd or os.time() >= CooldownEnd then
				local VictoryPart = ObbyParts[Difficulty]

				if Teleport(Config[1]) then
					-- Registra o horário do teleporte
					LastObbyTP = os.clock()

					print("[BL: Farm] Teleporte realizado | Dificuldade:", Difficulty)

					task.wait(1)

					ClaimObbyBonus:FireServer(VictoryPart)

					print("[BL: Farm] ClaimObbyBonus | Dificuldade:", Difficulty)

					-- Cooldown da recompensa
					Obby.DifficultyCD[Difficulty] = os.time() + Config.CD
					return true
				end
			end
		end
	end

	return false
end


-- // Auto Variants \\ --

local function AutoVariants()
	local Variants = AutoFarms.Variants

	if not Variants.Active then
		return false
	end

	local Config = Positions.Variants[VariantIndex]
	local VariantPart = VariantParts[VariantIndex]

	if not Config or not VariantPart then
		VariantIndex = 1
		return false
	end

	if Teleport(Config[1]) then
		print("[BL: Farm] Teleport realizado | Variante:", VariantIndex)

		task.wait(0.5)

		VariantCollect:FireServer(VariantPart)

		print("[BL: Farm] CollectVariantTokenSpawn | Variante:", VariantIndex)

		VariantIndex = (VariantIndex % #Positions.Variants) + 1

		return true
	end

	return false
end

-- // Halloween Interaction \\ --

local function PressE()
	VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)

	task.wait(0.1)

	VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

local function AutoHalloween()
	local Halloween = AutoFarms.Halloween

	if not Halloween.Active then
		return false
	end

	-- Não usa Lighting.IsNight nem WeatherService.
	if not CheckDayNight() then
		return false
	end

	local Config = Positions.Halloween[HalloweenIndex]

	if not Config then
		HalloweenIndex = 1
		return false
	end

	if not Teleport(Config[1]) then
		return false
	end

	task.wait(0.2)

	-- Evita interagir se o ciclo mudar durante o teleporte.
	if not CheckDayNight() then
		return false
	end

	print("[BL: Farm] Interagindo com porta Halloween | Posição:", HalloweenIndex)

	PressE()

	HalloweenIndex = (HalloweenIndex % #Positions.Halloween) + 1

	return true
end

-- // Main Loop \\ --

task.spawn(function()
	local LastItems = 0
	local LastVariants = 0
	local LastHalloween = 0

	while true do
		-- A verificação ocorre mesmo se Halloween estiver desligado.
		CheckDayNight()

		local Now = os.clock()
		local DidWork = false

		-- PRIORIDADE 1: VARIANTS
		if AutoFarms.Variants.Active
			and Now - LastVariants >= AutoFarms.Variants.TP_CD then

			if AutoVariants() then
				LastVariants = os.clock()
				DidWork = true
			end
		end

		-- PRIORIDADE 2: OBBY
		if not DidWork and AutoFarms.Obby.Active then
			if AutoObby() then
				DidWork = true
			end
		end

		-- PRIORIDADE 3: HALLOWEEN
		if not DidWork
			and AutoFarms.Halloween.Active
			and Now - LastHalloween >= AutoFarms.Halloween.TP_CD then

			if AutoHalloween() then
				LastHalloween = os.clock()

				-- Mantém as interações adicionais do código original.
				local StartTime = os.clock()

				while os.clock() - StartTime < 3 do
					if not CheckDayNight() then
						break
					end

					PressE()
					task.wait(0.1)
				end

				DidWork = true
			end
		end

		-- PRIORIDADE 4: ITEMS
		if not DidWork
			and AutoFarms.Items.Active
			and Now - LastItems >= AutoFarms.Items.TP_CD then

			if AutoItems() then
				LastItems = os.clock()
				DidWork = true
			end
		end

		task.wait(0.1)
	end
end)

